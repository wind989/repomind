# 本地开发示例。不要将真实密码、Token 或密钥提交到仓库。
APP_NAME=RepoMind API
DATABASE_URL=mysql+pymysql://repomind_user:replace_with_your_password@127.0.0.1:3306/repomind?charset=utf8mb4
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO
JWT_SECRET_KEY=generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=repomind_admin
BOOTSTRAP_ADMIN_PASSWORD=generate_a_strong_local_password
# 可选：本地 Chroma 持久化目录，默认是 storage/chroma。
CHROMA_PATH=storage/chroma
