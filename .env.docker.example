# 用于 docker compose --env-file .env.docker up --build。
# 请替换所有占位符；不要提交 .env.docker。
MYSQL_DATABASE=repomind
MYSQL_USER=repomind_user
MYSQL_PASSWORD=replace_with_a_url_safe_password
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password

# 容器内数据库主机名必须是 mysql，而不是 127.0.0.1。
DATABASE_URL=mysql+pymysql://repomind_user:replace_with_a_url_safe_password@mysql:3306/repomind?charset=utf8mb4
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LOG_LEVEL=INFO
JWT_SECRET_KEY=generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=repomind_admin
BOOTSTRAP_ADMIN_PASSWORD=generate_a_strong_local_password
